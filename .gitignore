
## `.gitignore`

```gitignore
# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Virtual environments
.venv/
venv/
env/
ENV/

# Jupyter
.ipynb_checkpoints/
*/.ipynb_checkpoints/

# Google Colab local files
/content/
/drive/
.colab/

# Data archives and raw datasets
data/
datasets/
raw_data/
processed_data/
*.zip
*.tar
*.tar.gz
*.tgz
*.gz
arxiv-metadata-s.json
test_sample.csv
nlp_s3_data.zip

# Retrieval artifacts and model outputs
artifacts/
outputs/
models/
checkpoints/
cache/
hf_cache/
huggingface_cache/
article_embeddings*.npy
*.npz
faiss_index*.bin
*.faiss
*.index
*.onnx
*.engine
*.plan

# Logs and profiling outputs
logs/
*.log
*.prof
*.profile

# Secrets and environment configuration
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
service-account*.json

# IDE settings
.vscode/
.idea/
*.iml

# Operating system files
.DS_Store
Thumbs.db
desktop.ini
